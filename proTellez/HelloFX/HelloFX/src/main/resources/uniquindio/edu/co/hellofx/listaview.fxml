<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uniquindio.edu.co.hellofx.controller.ListaController"
      spacing="12" alignment="CENTER" prefWidth="400" prefHeight="300">
    <padding><Insets topRightBottomLeft="20"/></padding>

    <Label text="Usuarios Registrados" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaUsuarios" prefWidth="360" prefHeight="200">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
            <TableColumn fx:id="colImagen" text="Imagen URL" prefWidth="180"/>
        </columns>
    </TableView>

    <Button text="Cerrar" onAction="#onCerrarVentana"/>
</VBox>
